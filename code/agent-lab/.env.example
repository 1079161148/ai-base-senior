# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会进版本库。

# ── 时间输出 ──────────────────────────────────────────────
# 只影响 API 响应里 created_at 这类字段的「显示形式」，
# 数据库里永远存 UTC。改完必须重启后端进程才生效。

# 1) 用哪个时区
#   true  = UTC        2026-11-08T15:09:04+00:00   跨时区不会错，推荐
#   false = 服务器本地  2026-11-08T23:09:04+08:00   看着顺眼，依赖部署机 tz
TIME_OUTPUT_UTC=true

# 2) 用哪种写法
#   iso   = 2026-11-08T23:09:04+08:00   国际标准，Safari / 任意语言都能解析
#   human = 2026-11-08 23:09:04         调试时好读，但丢了时区信息
TIME_FORMAT=iso
