# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会进版本库。

# ── 时间输出 ──────────────────────────────────────────────
# 只影响 API 响应里 created_at 这类字段的「显示形式」，
# 数据库里永远存 UTC。改完必须重启后端进程才生效。

# 1) 用哪个时区
#   true  = UTC        2026-11-08T15:09:04+00:00   跨时区不会错，推荐
#   false = 服务器本地  2026-11-08T23:09:04+08:00   看着顺眼，依赖部署机 tz
TIME_OUTPUT_UTC=true

# 2) 用哪种写法
#   iso   = 2026-11-08T23:09:04+08:00   国际标准，Safari / 任意语言都能解析
#   human = 2026-11-08 23:09:04         调试时好读，但丢了时区信息
TIME_FORMAT=iso

# ── 大模型（S1）─────────────────────────────────────────
# 走 OpenAI 兼容协议，改这三项就能换厂商。
# LLM_API_KEY 留空时，/api/v1/chat/stream 会返回 503 LLM_NOT_CONFIGURED，
# 其余接口（待办、demo 流）不受影响。

# 按你用的厂商取消注释其中一组：
#
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
#
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# 通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
#
# 智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
#
# 本地 Ollama（无需 Key，填任意非空字符串即可）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# 填你自己的 Key。这一行是唯一必填项。
LLM_API_KEY=

# 超时（秒）：connect 短一点让错误早点暴露，read 长一点等模型吐字
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60

# 单次回复上限，防止一口气生成几千 token。
# 推理模型（DeepSeek-R1 系、QwQ、o1 等）的思考过程也计入 token，
# 1024 常导致答案被截断，2048 更实际。
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ── S8：护栏与配额 ──────────────────────────────────────
# 单条输入上限（字）。超了直接 400，不送去模型 —— 长输入成本成倍上升。
GUARD_MAX_INPUT_CHARS=4000
# 命中高危注入模式时是拦截（true）还是只加固提示（false）。
# 生产建议 true：让模型自己判断"要不要拒绝"，它可能被同一句话说服。
GUARD_BLOCK_ON_INJECTION=true

# 每个 IP 每分钟请求数（内存令牌桶，单实例有效；多实例请换 Redis）
RATE_LIMIT_PER_MINUTE=20
# 同时进行的生成任务上限，保护模型账号的并发配额
MAX_CONCURRENT_REQUESTS=8
# 日成本上限（元）。超过后所有请求 429，第二天自动恢复。
# 单次成本上限挡不住"很多个很小的请求"，这道闸就是干这个的。
DAILY_COST_LIMIT_CNY=5.0

# ── 本地模型（RAG 嵌入）────────────────────────────────
# 模型从 HuggingFace 下载。国内直连 huggingface.co 必然超时，
# 表现为启动日志反复刷 "Could not download model ... retries left"。
# 换成社区镜像即可；能直连的话置空。
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存目录，默认 <项目>/data/models（90MB 左右）。
# 不要用默认的 %TEMP%/fastembed_cache —— Windows 磁盘清理会把它删掉，
# 下次启动就要重下。留空则用默认值。
# MODEL_CACHE_DIR=

# Cross-encoder 重排开关。默认关闭。
# 打开后首次使用会下载 bge-reranker-base（约 1.1GB），
# 且每次检索多花 2~3 秒 CPU 推理。
# 本项目实测（5 份文档 / 25 个 chunk）：
#   关闭 23ms，开启 2917ms，首位结果没有变好 ——
#   小知识库不值得，上万个 chunk 时再打开。
RERANK_ENABLED=false

# 送进重排模型的候选数，默认 20。
# 太小覆盖不到正确答案，太大则推理时间线性增长。
# RERANK_CANDIDATES=20

# ── S9：鉴权与多租户 ────────────────────────────────────
# 关掉后所有请求都算 demo 用户，方便本地调 Swagger / 跑脚本。
# 对外提供服务时必须是 true。
AUTH_ENABLED=true

# JWT 的 HS256 签名密钥。**上线前必须换掉**：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 用默认值 = 任何看过源码的人都能自己签一个 token 冒充任意用户。
AUTH_SECRET=dev-only-change-me-in-production

# token 有效期（秒），默认 7 天
AUTH_TOKEN_TTL_SECONDS=604800

# 启动时自动创建演示账号 demo/demo123。
# 演示环境开着方便，生产请关掉并改用脚本建账号。
SEED_DEMO_USER=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
