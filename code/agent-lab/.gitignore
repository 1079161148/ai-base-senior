# ── Python ──────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── 环境变量：含密钥，绝对不允许提交 ────────────────────
# .env.example 除外（那是给别人看格式的模板）
.env
.env.local
.env.*.local
!.env.example

# ── 运行时数据 ──────────────────────────────────────────
# 数据库是本地状态，不该跟随代码走；新环境启动会自动重建
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# ── 编辑器 / 系统 ───────────────────────────────────────
# .vscode 里有本机绝对路径（解释器、tsdk），提交会污染别人的环境
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ── 日志 ────────────────────────────────────────────────
*.log
