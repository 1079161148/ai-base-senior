# ── Python ──────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── 环境变量：含密钥，绝对不允许提交 ────────────────────
# .env.example 除外（那是给别人看格式的模板）
.env
.env.local
.env.*.local
!.env.example

# ── 运行时数据 ──────────────────────────────────────────
# 数据库是本地状态，不该跟随代码走；新环境启动会自动重建
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 本地模型缓存（90MB+），首次启动自动从镜像下载，不该进版本库
data/models/

# 运行时 trace：每轮对话的完整记录，含用户提问、待办内容、工具参数。
# 属于本地使用痕迹，既不该公开，也会让仓库迅速膨胀。
# （trace 面板读的是本地文件，清掉不影响功能）
data/traces/

# 评测报告是「某一次运行」的产物，可随时重跑生成；
# 评测集 suite.json 是资产，必须入库，所以只忽略 *_report.json。
data/eval/*_report.json

# ── 编辑器 / 系统 ───────────────────────────────────────
# .vscode 里有本机绝对路径（解释器、tsdk），提交会污染别人的环境
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ── 日志 ────────────────────────────────────────────────
*.log
